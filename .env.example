FEISHU_APP_ID=cli_xxxxx
FEISHU_APP_SECRET=xxxxx

# 鉴权模式：tenant（默认）或 user
FEISHU_AUTH_MODE=tenant

# 仅在 FEISHU_AUTH_MODE=user 时需要
# FEISHU_REDIRECT_URI=http://127.0.0.1:8765/callback
# FEISHU_USER_SCOPES=docx:document:readonly wiki:wiki:readonly offline_access
# 读取 Bitable 时追加：bitable:app:readonly
# 按关键词搜索云空间文档时追加：drive:drive:readonly
# FEISHU_TOKEN_FILE=~/.feishu-mcp/tokens.json

# 可选配置
FEISHU_DOCUMENT_URL_BASE=https://feishu.cn/docx
FEISHU_REQUEST_TIMEOUT=15
LOG_LEVEL=INFO
